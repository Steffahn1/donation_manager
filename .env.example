# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://donations:donations@localhost:5432/donations?schema=public"

# Public base URL of the app (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"

# Stripe TEST mode keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# Mailpit (local test inbox)
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="Donation Manager <no-reply@donations.local>"

# Seeded super admin
SEED_ADMIN_EMAIL="admin@charity.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
